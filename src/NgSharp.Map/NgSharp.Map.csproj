<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NgSharp.Map</PackageId>
    <Version>3.0.0</Version>
    <PackageReleaseNotes>3.0 — aligned with the NgSharp 3.0 engine.

- Complex-type component binding makes MapPoints bindable from templates
- The component is functional end-to-end, covered by real render tests</PackageReleaseNotes>
    <Authors>Nayruu</Authors>
    <Description>Static Google Maps component for NgSharp — renders map markers with SkiaSharp. Optional add-on so the NgSharp core stays free of the native SkiaSharp dependency.</Description>
    <PackageTags>ngsharp map staticmap googlemaps skiasharp component</PackageTags>
    <RepositoryUrl>https://github.com/Nayruuu/NgSharp</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Nayruuu/NgSharp</PackageProjectUrl>
    <RootNamespace>NgSharp.Components</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- File-scoped namespaces (team convention) need C# 10+; every feature used is syntax-only, so
         the netstandard2.1 target compiles identically. -->
    <LangVersion>12</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NgSharp\NgSharp.csproj" />
  </ItemGroup>

</Project>
