<div class="devis">
<header class="devis-head">
<div class="issuer">
<h1>{{upper Issuer.Name}}</h1>
<p>{{Issuer.Address}}</p>
<p>{{Issuer.Zip}} {{Issuer.City}}</p>
<p>SIRET {{Issuer.Siret}} — TVA {{Issuer.Tva}}</p>
<p>{{Issuer.Phone}} — {{Issuer.Email}}</p>
<p class="contact">Contact : {{Issuer.Contact}}</p>
</div>
<div class="meta">
<h2>DEVIS N° {{Number}}</h2>
<p>Référence : {{Reference}}</p>
<p>Émis le {{date IssueDate "dd/MM/yyyy"}}</p>
<p>Valable jusqu'au {{date ValidUntil "dd/MM/yyyy"}}</p>
</div>
</header>
<section class="client">
<h3>Client</h3>
<p class="name">{{Client.Name}}</p>
<p>{{Client.Address}}</p>
<p>{{Client.Zip}} {{Client.City}}</p>
<p>À l'attention de {{Client.Contact}}</p>
<p>{{Client.Phone}} — {{Client.Email}}</p>
</section>
<section class="campaign">
<h3>{{upper CampaignName}}</h3>
<p>Du {{date CampaignStart "dd/MM/yyyy"}} au {{date CampaignEnd "dd/MM/yyyy"}}</p>
<p>Volume global estimé : {{largeNumber TotalImpressions}} impressions</p>
</section>
{{#each Sections}}<section class="reseau">
<div class="section-head">
<h3>{{upper Title}}</h3>
<p class="subtitle">{{Subtitle}}</p>
{{#if HasDiscount}}<span class="badge-remise">Remise réseau appliquée</span>{{/if}}
</div>
<table class="lignes">
<thead>
<tr><th>Réf</th><th>Emplacement</th><th>Format</th><th>Ville</th><th>Qté</th><th>Impressions</th><th>Période</th><th>P.U. HT</th><th>Remise</th><th>Total HT</th><th>Statut</th></tr>
</thead>
<tbody>
{{#each Lines}}<tr>
<td class="ref">{{Ref}}</td>
<td class="label">{{Label}}</td>
<td>{{Format}}</td>
<td>{{City}}</td>
<td class="qte">{{Quantity}}</td>
<td class="impr">{{largeNumber Impressions}}</td>
<td class="periode">{{date StartDate "dd/MM/yyyy"}} → {{date EndDate "dd/MM/yyyy"}}</td>
<td class="pu">{{num UnitPrice "N2"}} €</td>
<td class="remise">
{{#if (truthy Discount)}}<span>- {{num Discount "N2"}} €</span>{{/if}}
</td>
<td class="total">{{num TotalHT "N2"}} €</td>
<td class="statut">
{{#if InStock}}<span class="ok">Disponible</span>{{/if}}
{{#if OnOption}}<span class="opt">Sur option</span>{{/if}}
{{#if Highlighted}}<span class="star">★</span>{{/if}}
</td>
</tr>{{/each}}
</tbody>
</table>
<div class="section-total">
<p>Volume section : {{largeNumber SectionImpressions}} impressions</p>
<p>Sous-total HT : <strong>{{num SubtotalHT "N2"}} €</strong></p>
</div>
</section>{{/each}}
{{#if HasOptions}}<section class="options">
<h3>Options proposées</h3>
<ul>
{{#each Options}}<li>{{Text}}</li>{{/each}}
</ul>
</section>{{/if}}
<section class="totaux">
<table>
<tr><td>Total HT</td><td class="amount">{{num TotalHT "N2"}} €</td></tr>
<tr><td>TVA ({{num TvaRate "P0"}})</td><td class="amount">{{num TotalTva "N2"}} €</td></tr>
<tr class="ttc"><td>Total TTC</td><td class="amount">{{num TotalTTC "N2"}} €</td></tr>
</table>
</section>
<section class="cgv">
<h3>Conditions générales</h3>
<ol>
{{#each Terms}}<li>{{Text}}</li>{{/each}}
</ol>
</section>
<footer class="devis-foot">
<p class="notes">{{Notes}}</p>
<p>Fait à {{Issuer.City}}, le {{date IssueDate "dd/MM/yyyy"}}</p>
<p class="mentions">{{Issuer.Name}} — SIRET {{Issuer.Siret}} — TVA {{Issuer.Tva}}</p>
</footer>
</div>
