<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <PropertyGroup>
        <PreserveCompilationContext>true</PreserveCompilationContext>
        <CopyRefAssembliesToPublishDirectory>true</CopyRefAssembliesToPublishDirectory>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
      <PackageReference Include="Fluid.Core" Version="2.31.0" />
      <PackageReference Include="Handlebars.Net" Version="2.1.6" />
      <PackageReference Include="RazorLight" Version="2.3.1" />
      <PackageReference Include="Scriban" Version="7.2.5" />
      <PackageReference Include="Stubble.Core" Version="1.10.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\NgSharp\NgSharp.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- Engine templates embedded so they travel with the assembly (BenchmarkDotNet runs each
           benchmark in a generated child process where a file-relative read would not find them). -->
      <EmbeddedResource Include="Templates\*" />
    </ItemGroup>

</Project>
